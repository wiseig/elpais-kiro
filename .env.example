# Variables de shell para operar el repo. Nunca guardar secretos acá.
AWS_PROFILE=dailybrief
AWS_REGION=us-east-1
# Entorno destino de los scripts (dev|prod)
PELP_ENV=dev
# Mail que recibe las alarmas (SNS). Se pasa a CDK como contexto alertEmail.
PELP_ALERT_EMAIL=
# App client del pool de Cognito de Daily Brief (us-east-1_PbNEhPTSl) para el login del backoffice
# Origen permitido por CORS en las APIs (por defecto *)
PELP_ALLOWED_ORIGIN=
# Apaga los schedules de dev (FinOps): true|false
DEV_SHUTDOWN=false

# WhatsApp por AWS End User Messaging Social. El id del número de origen aparece en la consola
# después de vincular la cuenta (Embedded Signup). No es secreto. Vacío = la entrega falla cerrado.
PELP_WHATSAPP_ORIGINATION_PHONE_NUMBER_ID=
