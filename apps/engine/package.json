{
  "name": "@pelp/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Motor de respuestas (Lambda pelp-engine): guardrails, recuperación, canónica, adaptación, verificación y rutas públicas /v1.",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1131.0",
    "@aws-sdk/client-eventbridge": "3.1131.0",
    "@aws-sdk/client-polly": "3.1131.0",
    "@aws-sdk/client-s3": "3.1131.0",
    "@aws-sdk/client-secrets-manager": "3.1131.0",
    "@aws-sdk/lib-dynamodb": "3.1131.0",
    "@aws-sdk/s3-request-presigner": "3.1131.0",
    "@pelp/bedrock": "workspace:*",
    "@pelp/channel-sdk": "workspace:*",
    "@pelp/domain": "workspace:*",
    "@pelp/prompts": "workspace:*",
    "@pelp/testing": "workspace:*",
    "@smithy/signature-v4": "5.7.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.163",
    "@types/node": "22.20.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
