{
  "name": "@pelp/backoffice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backoffice (React + Vite + TS) autenticado contra el pool de Cognito de Daily Brief, grupo admin.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1131.0",
    "@pelp/domain": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
