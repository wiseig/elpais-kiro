{
  "name": "pregunta-elpais",
  "private": true,
  "version": "0.2.0",
  "description": "Preguntale a El País: asistente conversacional sobre notas publicadas por El País (Uruguay).",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "synth": "pnpm --filter @pelp/infrastructure synth",
    "deploy": "./scripts/deploy.sh",
    "seed:config": "node scripts/seed-config.mjs",
    "evals": "node scripts/run-evals.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.2",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "3.2.7"
  }
}
